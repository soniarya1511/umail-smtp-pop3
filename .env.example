# Copy to .env and adjust. Never commit the real .env.

# Required: generate with
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Database credentials (only reachable inside the docker network)
POSTGRES_USER=umail
POSTGRES_PASSWORD=umail

# Demo mailboxes created on first start: "email:password" separated by spaces
MAIL_USERS=alice@posthawk.com:alice123 bob@posthawk.com:bob123 charlie@swiftmail.com:charlie123
